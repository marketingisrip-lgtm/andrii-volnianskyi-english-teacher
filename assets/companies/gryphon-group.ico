				<div data-elementor-type="wp-page" data-elementor-id="17804" class="elementor elementor-17804" data-elementor-post-type="page">
				<div data-particle_enable="false" data-particle-mobile-disabled="false" class="elementor-element elementor-element-7f40028 e-con-full e-flex e-con e-parent" data-id="7f40028" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-bf129ea elementor--h-position-center elementor--v-position-middle elementor-widget elementor-widget-slides" data-id="bf129ea" data-element_type="widget" data-e-type="widget" data-settings="{&quot;autoplay_speed&quot;:8000,&quot;transition_speed&quot;:1000,&quot;transition&quot;:&quot;fade&quot;,&quot;navigation&quot;:&quot;none&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;infinite&quot;:&quot;yes&quot;}" data-widget_type="slides.default">
				<div class="elementor-widget-container">
									<div class="elementor-swiper">
					<div class="elementor-slides-wrapper elementor-main-swiper swiper" role="region" aria-roledescription="carousel" aria-label="Gryphon" dir="ltr" data-animation="fadeInUp">
				<div class="swiper-wrapper elementor-slides">
										<div class="elementor-repeater-item-8764d4c swiper-slide" role="group" aria-roledescription="slide"><div class="swiper-slide-bg elementor-ken-burns elementor-ken-burns--in" role="img" aria-label="Gryphon - PRI"></div><div class="elementor-background-overlay"></div><div class="swiper-slide-inner" ><div class="swiper-slide-contents"></div></div></div>				</div>
